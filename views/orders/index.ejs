<%- include('../partials/header') %>
<h1>Orders</h1>
<nav class="tabs">
  <a href="/orders" class="<%= tab === 'purchases' ? 'active' : '' %>">Purchases<% if (counts.buying) { %> <span class="badge"><%= counts.buying %></span><% } %></a>
  <a href="/orders?tab=sales" class="<%= tab === 'sales' ? 'active' : '' %>">Sales<% if (counts.selling) { %> <span class="badge"><%= counts.selling %></span><% } %></a>
</nav>
<% if (!orders.length) { %>
  <div class="empty"><p><%= tab === 'sales' ? "You haven't sold anything yet." : "You haven't bought anything yet." %></p>
    <a class="btn btn-primary" href="<%= tab === 'sales' ? '/listings/new' : '/' %>"><%= tab === 'sales' ? 'Post an item' : 'Browse items' %></a></div>
<% } else { %>
  <div class="list">
    <% orders.forEach(function (o) { %>
      <a class="list-row" href="/orders/<%= o.id %>">
        <img src="<%= o.cover ? '/uploads/' + o.cover : '/static/img/placeholder.svg' %>" alt="">
        <span class="grow">
          <strong><%= o.listing_title %></strong>
          <span class="muted small block">#<%= o.id %> · <%= tab === 'sales' ? 'Buyer: ' + o.buyer_name : 'Seller: ' + o.seller_name %> · <%= formatDate(o.created_at) %></span>
        </span>
        <span class="status status-<%= o.status %>"><%= ORDER_STATUS_LABEL[o.status] %></span>
        <span class="price"><%= formatMoney(o.amount_cents) %></span>
      </a>
    <% }) %>
  </div>
<% } %>
<%- include('../partials/footer') %>
