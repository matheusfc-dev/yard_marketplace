<%- include('../partials/header') %>
<h1>Users</h1>
<%- include('../partials/admin-nav') %>
<form class="row gap-sm toolbar" method="get">
  <input type="search" name="q" value="<%= q %>" placeholder="Search username, name or email">
  <select name="filter"><option value="">All users</option><option value="banned" <%= filter === 'banned' ? 'selected' : '' %>>Banned</option><option value="admin" <%= filter === 'admin' ? 'selected' : '' %>>Admins</option></select>
  <button class="btn btn-primary">Search</button>
</form>
<div class="table-wrap"><table class="table">
  <thead><tr><th>User</th><th>Email</th><th>Joined</th><th class="num">Listings</th><th class="num">Sales</th><th class="num">Reports</th><th>Status</th><th></th></tr></thead>
  <tbody>
  <% users.forEach(function (u) { %>
    <tr>
      <td><a href="/admin/users/<%= u.id %>"><strong><%= u.display_name %></strong></a><br><span class="muted small">@<%= u.username %></span></td>
      <td class="small"><%= u.email %></td>
      <td class="small nowrap"><%= formatDate(u.created_at) %></td>
      <td class="num"><%= u.listings %></td>
      <td class="num"><%= u.sales %></td>
      <td class="num <%= u.reports ? 'danger' : '' %>"><%= u.reports %></td>
      <td><% if (u.role === 'admin') { %><span class="tag tag-admin">Admin</span><% } %><% if (u.banned) { %><span class="tag tag-banned" title="<%= u.ban_reason %>">Banned</span><% } else { %><span class="tag">Active</span><% } %></td>
      <td><a class="btn btn-ghost btn-sm" href="/admin/users/<%= u.id %>">Manage</a></td>
    </tr>
  <% }) %>
  </tbody>
</table></div>
<% if (!users.length) { %><p class="muted">No users found.</p><% } %>
<%- include('../partials/footer') %>
